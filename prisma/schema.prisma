datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model LeetCodeProfile {
  id            String   @id @default("default")
  username      String
  totalSolved   Int      @default(0)
  easySolved    Int      @default(0)
  mediumSolved  Int      @default(0)
  hardSolved    Int      @default(0)
  contestRating Float    @default(0.0)
  streak        Int      @default(0)
  updatedAt     DateTime @updatedAt
}

model JobApplication {
  id        String   @id @default(uuid())
  company   String
  role      String
  deadline  DateTime
  status    String   // "Interested" | "Applied" | "OA" | "Interview" | "Offer" | "Rejected"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ReadinessScore {
  id             String   @id @default("default")
  dsaScore       Float    @default(52.0) // default from spec
  csScore        Float    @default(50.0)
  resumeScore    Float    @default(50.0)
  projectsScore  Float    @default(50.0)
  interviewScore Float    @default(50.0)
  updatedAt      DateTime @updatedAt
}
