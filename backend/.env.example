# Start ARQ worker (requires REDIS_URL):
#   cd backend && arq app.workers.settings.WorkerSettings
DATABASE_URL=sqlite:///./placementos.db
REDIS_URL=
REDIS_TOKEN=
JWT_SECRET=change-me-to-a-256-bit-random-secret
JWT_REFRESH_SECRET=change-me-to-a-separate-refresh-secret
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
SENTRY_DSN=
FRONTEND_URL=http://localhost:3000
API_URL=http://localhost:8000
DEBUG=true
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
RESEND_API_KEY=
LOCAL_STORAGE_DIR=./storage

# --- Production notes -------------------------------------------------------
# Neon (pooled/PgBouncer): DATABASE_URL=postgresql+psycopg://USER:PW@HOST/db?sslmode=require
# Upstash Redis: REDIS_URL=rediss://... (REDIS_TOKEN if using the REST/token auth)

# Phase 7 — coding judge (leave JUDGE_URL empty to use mock verdicts)
JUDGE_URL=
JUDGE_PROVIDER=judge0
JUDGE_API_KEY=

# Phase 9 — billing (BILLING_ENABLED=false + empty keys => mock provider)
BILLING_ENABLED=false
BILLING_PROVIDER=stripe
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Phase 9 — advanced AI / PWA push
EMBEDDINGS_MODEL=voyage-3-lite
VAPID_PUBLIC_KEY=

# Phase 9 — Postgres connection pooling (ignored on SQLite)
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE=1800
