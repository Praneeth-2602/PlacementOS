# Start ARQ worker (requires REDIS_URL):
#   cd backend && arq app.workers.settings.WorkerSettings
DATABASE_URL=sqlite:///./placementos.db
REDIS_URL=
REDIS_TOKEN=
JWT_SECRET=change-me-to-a-256-bit-random-secret
JWT_REFRESH_SECRET=change-me-to-a-separate-refresh-secret
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
SENTRY_DSN=
FRONTEND_URL=http://localhost:3000
API_URL=http://localhost:8000
DEBUG=true
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
